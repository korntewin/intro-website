---
import '../styles/global.css';
import '../styles/theme.css';
import ThemeToggle from '../components/ThemeToggle.svelte';

const {
  title = 'Korntewin · ML Engineering',
  description = 'Korntewin portfolio and engineering notes',
  lang = 'en',
  portfolio = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/career/', label: 'Career' },
  { href: '/projects/', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      // Set the theme before paint to avoid a flash of the wrong theme.
      try {
        const saved = localStorage.getItem('korntewin-theme');
        document.documentElement.dataset.theme = saved === 'dark' || saved === 'light'
          ? saved
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body class={portfolio ? 'portfolio-mode' : undefined}>
    <header class="site-header">
      <nav class="nav wrap" aria-label="Main navigation">
        <a class="brand" href={base + '/'}>Korntewin<span class="accent">.</span></a>
        <div class="navlinks">
          {nav.map(item => <a href={base + item.href}>{item.label}</a>)}
          <ThemeToggle client:load />
          <slot name="nav-action" />
        </div>
      </nav>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="wrap footer">
      © 2026 Korntewin · Built with Astro & Svelte · <a href="https://github.com/korntewin">GitHub</a>
    </footer>
  </body>
</html>
