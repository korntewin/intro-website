---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.svelte';
import '../styles/portfolio.css';
import '../styles/blog.css';

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site ?? Astro.url.origin).href;
const publishedDate = new Date(frontmatter.date).toISOString().slice(0, 10);
const coverImage = frontmatter.coverImage ? new URL(frontmatter.coverImage, canonical).href : undefined;
const language = frontmatter.language === 'en' ? 'en' : 'th';
const rootArticleUrl = language === 'en' ? canonical.replace(/en\/$/, '') : canonical;
const thaiUrl = rootArticleUrl;
const englishUrl = rootArticleUrl + 'en/';
const mediumUrl = rootArticleUrl + 'medium/' + language + '/';
---
<BaseLayout title={frontmatter.title + ' · Korntewin'} description={frontmatter.description} lang={language} portfolio={true}>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="th" href={thaiUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:description" content={frontmatter.description} />
    <meta property="og:url" content={canonical} />
    <meta property="article:published_time" content={publishedDate} />
    {coverImage && <meta property="og:image" content={coverImage} />}
    {coverImage && <meta property="og:image:alt" content={frontmatter.coverImageAlt ?? frontmatter.title} />}
  </Fragment>
  <ReadingProgress client:load />
  <div class="portfolio blog-article-page">
    <div class="back blog-back blog-reader-utility">
      <a href={base + '/blog/'}>{language === 'th' ? '← บทความทั้งหมด' : '← All articles'}</a>
      <nav class="blog-language-switch" aria-label="Article language">
        <a href={thaiUrl} lang="th" aria-current={language === 'th' ? 'page' : undefined}>TH</a>
        <a href={englishUrl} lang="en" aria-current={language === 'en' ? 'page' : undefined}>EN</a>
      </nav>
      <a class="blog-medium-link" href={mediumUrl}>Medium export ({language.toUpperCase()}) ↗</a>
    </div>
    <article class="reading prose article-prose h-entry" aria-labelledby="post-title" itemscope itemtype="https://schema.org/BlogPosting">
      <h1 id="post-title" class="p-name" itemprop="headline">{frontmatter.title}</h1>
      <p class="eyebrow">ENGINEERING NOTES · <time class="dt-published" datetime={publishedDate} itemprop="datePublished">{publishedDate}</time></p>
      <p class="intro p-summary" itemprop="description">{frontmatter.description}</p>
      <div class="e-content entry-content" itemprop="articleBody">
        <slot />
      </div>
    </article>
    <div class="blog-reader-end">
      <a class="port-inline-link" href={base + '/blog/'}>{language === 'th' ? '← บทความอื่น ๆ' : '← More engineering notes'}</a>
    </div>
  </div>
</BaseLayout>
