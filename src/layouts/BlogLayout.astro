---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.svelte';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={frontmatter.title + ' · Korntewin'} description={frontmatter.description} lang="th">
  <ReadingProgress client:load />
  <section class="reading">
    <p class="back"><a href={base + '/blog/'}>← บทความทั้งหมด</a></p>
    <p class="eyebrow">ENGINEERING NOTES · {frontmatter.date}</p>
    <h1>{frontmatter.title}</h1>
    <p class="intro">{frontmatter.description}</p>
    <article class="prose article-prose"><slot /></article>
  </section>
</BaseLayout>
